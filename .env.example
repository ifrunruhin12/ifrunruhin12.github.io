# Copy to .env and adjust. The app loads .env on startup when the file exists.
# Real environment variables override values from .env.

# Required for admin (/admin login, CRUD projects, edit intro). Leave empty to disable admin UI.
ADMIN_PASSWORD=

# Optional: separate key for signing the admin cookie (defaults to ADMIN_PASSWORD).
# ADMIN_SESSION_KEY=

# Optional: listener port (default 8080).
# PORT=8080

# Optional: SQLite datasource name passed to sqlite3.Open (default portfolio.db?_foreign_keys=on).
# PORTFOLIO_DB=portfolio.db?_foreign_keys=on

# Publish to GitHub Pages: after saving in the local admin, generate plain HTML then commit:
#   CGO_ENABLED=1 go run ./cmd/export
